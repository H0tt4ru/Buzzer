# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------

# Safe to expose to the browser. Students and the teacher both use this key.
# Every table is protected by RLS; the only thing readable with this key is the
# public `game_pulse` row. All writes go through SECURITY DEFINER functions
# that require a student token or the admin token.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by the /api/games routes to
# call the teacher-only database functions. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Used to build the student links the teacher copies (no trailing slash).
# On Vercel this can be left unset; it falls back to VERCEL_URL / window.origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
